{
  "permissions": {
    "ask": [
      "Edit(./tests/check.py)",
      "Write(./tests/check.py)",
      "Edit(./DOCS/results/**)",
      "Write(./DOCS/results/**)",
      "Edit(./DOCS/Run-Record-*.md)",
      "Write(./DOCS/Run-Record-*.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'python3 tests/check.py --scripts'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
